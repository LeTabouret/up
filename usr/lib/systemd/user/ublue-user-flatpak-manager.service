[Unit]
Description=Reconcile user Flatpaks with the image desired state
Documentation=https://github.com/LeTabouret/up
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=oneshot
ExecStart=/usr/libexec/ublue-user-flatpak-manager
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
