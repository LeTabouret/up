#!/usr/bin/bash

set -euo pipefail

readonly CONFIG_DIR="${FLATPAK_MANAGER_CONFIG_DIR:-/etc/flatpak/user}"
readonly INSTALL_FILE="${CONFIG_DIR}/install"
readonly REMOVE_FILE="${CONFIG_DIR}/remove"
readonly REMOTE_FILE="${FLATPAK_MANAGER_REMOTE_FILE:-/etc/flatpak/remotes.d/flathub.flatpakrepo}"
readonly STATE_DIR="${XDG_DATA_HOME:-${HOME}/.local/share}/ublue"
readonly STATE_FILE="${FLATPAK_MANAGER_STATE_FILE:-${STATE_DIR}/flatpak-manager.sha256}"
readonly SCRIPT_FILE="${BASH_SOURCE[0]}"

read_list() {
    local file="$1"
    [[ -f "$file" ]] || return 0
    sed -e 's/[[:space:]]*#.*$//' -e '/^[[:space:]]*$/d' "$file"
}

desired_state_hash() {
    {
        sha256sum "$SCRIPT_FILE"
        for file in "$INSTALL_FILE" "$REMOVE_FILE" "$REMOTE_FILE"; do
            [[ -f "$file" ]] && sha256sum "$file" || printf 'missing  %s\n' "$file"
        done
    } | sha256sum | cut -d' ' -f1
}

main() {
    local desired_hash previous_hash="" application
    local -a install_list=() remove_list=() installed_removals=()

    mapfile -t install_list < <(read_list "$INSTALL_FILE")
    mapfile -t remove_list < <(read_list "$REMOVE_FILE")
    desired_hash="$(desired_state_hash)"
    [[ -f "$STATE_FILE" ]] && read -r previous_hash < "$STATE_FILE"
    if [[ "$desired_hash" == "$previous_hash" ]]; then
        echo "Managed Flatpak configuration is unchanged."
        return 0
    fi

    mkdir -p "$STATE_DIR"
    if flatpak remotes --user --columns=name | grep -Fxq fedora; then
        flatpak remote-delete --user --force fedora
    fi
    flatpak remote-add --user --if-not-exists flathub "$REMOTE_FILE"
    flatpak remote-modify --user --enable --prio=2 flathub

    if ((${#install_list[@]} > 0)); then
        flatpak install --user --noninteractive --or-update -- flathub "${install_list[@]}"
    fi
    for application in "${remove_list[@]}"; do
        if flatpak info --user "$application" > /dev/null 2>&1; then
            installed_removals+=("$application")
        fi
    done
    if ((${#installed_removals[@]} > 0)); then
        flatpak uninstall --user --noninteractive -- "${installed_removals[@]}"
    fi

    printf '%s\n' "$desired_hash" > "${STATE_FILE}.tmp"
    mv -f "${STATE_FILE}.tmp" "$STATE_FILE"
    notify-send "Flatpak installer" "Finished applying managed user Flatpak configuration" \
        --app-name="Flatpak installer" --urgency=normal 2> /dev/null || true
}

main "$@"
